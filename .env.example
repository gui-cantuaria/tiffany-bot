# === Required ===
DISCORD_TOKEN=your_discord_token
OPENROUTER_API_KEY=your_openrouter_key
CANAL_NOTICIAS_ID=your_news_channel_id
ID_CARGO_PARA_MARCAR=your_news_role_id
GUILD_ID=your_guild_id
BOT_OWNER_ID=your_discord_user_id

# === Lavalink cluster (optional — LavaSrc + YouTube plugin) ===
# bash scripts/start-lavalink.sh
# LAVALINK_ENABLED=1
# LAVALINK_HOST=127.0.0.1
# LAVALINK_PORT=2333
# LAVALINK_PASSWORD=
# LAVALINK_NODE_ID=primary
# Multi-node JSON (bot orchestrates; WARP must run on each node host):
# LAVALINK_NODES=[{"uri":"http://127.0.0.1:2333","password":"secret","identifier":"primary"},{"uri":"http://127.0.0.1:2334","password":"secret","identifier":"secondary"}]
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# === Infrastructure (optional — HA / premium / DB-backed features) ===
# DATABASE_URL=postgresql://user:pass@localhost:5432/tiffany
# DATABASE_SSL=require  # production: omit or require/verify-* (asyncpg TLS). Never disable in prod.
# DATABASE_SSL=disable  # integration tests only (local Docker PostgreSQL on 127.0.0.1:5433)
# REDIS_URL=redis://localhost:6379/0
# PREMIUM_CACHE_TTL_SEC=300
# GOOGLE_SAFE_BROWSING_API_KEY=

# === Lavalink (legacy single-node — use LAVALINK_NODES for cluster) ===

# === Voice (optional) ===
# VOICE_ENABLED=1
# Wake-word voice commands (STT). Default 0 — music via t! only; chat via t!c / /chat.
# VOICE_STT_ENABLED=0
# DM: require user to share at least one server with the bot (default 1). Set 0 to allow any DM.
# DM_REQUIRE_SHARED_GUILD=1
# Rejoin voice channel automatically after bot restart (recommended on VPS: 1)
# VOICE_AUTO_REJOIN=1
# Max age (seconds) of voice_state.json queue snapshot to restore after restart (default 1800 when auto-rejoin on)
# VOICE_STATE_MAX_AGE_SEC=1800
# TTS_ENABLED=1
# STT_OPENROUTER_ENABLED=1
# Legacy alias (same as STT_OPENROUTER_ENABLED):
# STT_GEMINI_FALLBACK=1
# Primary STT: Whisper via OpenRouter (see docs/voice-technical.md)
# STT_OPENROUTER_MODEL=openai/whisper-large-v3
# Fallback chat STT when Whisper fails or wake word missing
# STT_CHAT_MODEL=google/gemini-3.1-flash-lite
# Save last captured WAV to /tmp/tiffany_debug_audio.wav for STT debugging
# DEBUG_STT=1
# FFMPEG_PATH=
# Game history TTL (days, default 30) and max users (default 2000)
# GAME_HISTORY_TTL_DAYS=30
# GAME_HISTORY_MAX_USERS=2000
# Offers enrichment parallelism (default 4 concurrent, 0.35s delay per slot)
# OFFERS_ENRICH_CONCURRENCY=4
# OFFERS_ENRICH_DELAY_SEC=0.35
# WARP proxy health alerts via DISCORD_WEBHOOK_HEALTHCHECK (default on)
# WARP_MONITOR=1
# WARP_MONITOR_INTERVAL_SEC=300

# === WARP proxy (VPS only — required for YouTube/yt-dlp) ===
# YouTube blocks datacenter IPs. Install once: bash scripts/warp-setup.sh
# SOCKS5 proxy at 127.0.0.1:40000 (hardcoded in tiffany_voice YDL_OPTS).
# Healthcheck timer tiffany-warp-healthcheck reconnects if proxy drops.
# News/offers still start if WARP is down; music commands fail without it.

# === Dice (optional) ===
# DICE_CHANNELS=123456789,987654321
# Delete @rollem-next replies in dice channels (needs Manage Messages). 0 = off
# DICE_DELETE_ROLLEM=1
# Also delete classic @rollem (240732567744151553)
# ROLLEM_DELETE_ALL=0
# Custom bot IDs (replaces default): ROLLEM_DELETE_BOT_IDS=840409146738475028

# === Offers (optional) ===
# CANAL_OFERTAS_ID=1512902840908124281
# ID_CARGO_OFERTAS=1386386059390357575

# === Affiliate (all optional) ===
# AMAZON_AFFILIATE_TAG=
# MERCADOLIVRE_AFFILIATE_ID=
# AWIN_PUBLISHER_ID=
# MAGALU_LOJA_SLUG=
# TERABYTE_AFFILIATE_ID=
# SHOPINFO_AFFILIATE_ID=
# SHOPINFO_PARAM_NAME=
# ALIEXPRESS_AFFILIATE_ID=
# LOMADEE_APP_TOKEN=
# LOMADEE_SOURCE_ID=

# === Stripe Premium (optional — enables /premium command and webhook server) ===
# Get keys from https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret from Stripe Dashboard → Developers → Webhooks
# STRIPE_WEBHOOK_SECRET=whsec_...
# Port for the internal aiohttp webhook server (default 8080)
# STRIPE_WEBHOOK_PORT=8080
# STRIPE_WEBHOOK_MAX_BODY_BYTES=262144
# STRIPE_WEBHOOK_TOLERANCE_SEC=300
# STRIPE_RECONCILE_INTERVAL_SEC=3600
# Map Stripe Price IDs to Tiffany package tiers (JSON dict)
# STRIPE_PRICE_MAP={"price_xxx":"offers","price_yyy":"news","price_zzz":"ultimate"}
# Or set individually:
# STRIPE_PRICE_OFFERS=price_xxx
# STRIPE_PRICE_NEWS=price_yyy
# STRIPE_PRICE_ULTIMATE=price_zzz

# === Affiliate Custom IDs (optional) ===
# MERCADOLIVRE_TOOL_ID=
# SHOPEE_AFFILIATE_ID=

# === Imagine / AI Image Generation (optional) ===
# IMAGINE_MODEL=google/imagen-3-fast
# IMAGINE_ASPECT_RATIO=1:1

# === Dashboard API (optional) ===
# DASHBOARD_API_HOST=127.0.0.1
# DASHBOARD_API_PORT=8081


